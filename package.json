{
  "name": "dsh-dexter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Windows-only desktop hands for DeepSeek Harness: four tools, one authorization gate, one audit trail.",
  "license": "MIT",
  "main": "index.js",
  "icon": "icon.svg",
  "os": [
    "win32"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.3.0"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "files": [
    "index.js",
    "client.js",
    "kernel",
    "backends",
    "vendor",
    "ui",
    "tools",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "SECURITY.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node tools/check-repo.mjs",
    "surface": "node tools/measure-surface.mjs dexter",
    "test": "node test/run-all.mjs"
  }
}
